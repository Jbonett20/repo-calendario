# =====================================================
# monchomania - Plantilla de variables de entorno
# Copia este archivo como `.env` y ajusta los valores.
# =====================================================

# --- Aplicación ---
APP_NAME="monchomania"
APP_ENV=production
# true = muestra errores (solo desarrollo). En producción deja false.
APP_DEBUG=false

# --- URL base de la aplicación (SIN barra final) ---
# Local (XAMPP):  http://localhost/misproyectos/moncho
# Hostinger:      https://tudominio.com        (o con subcarpeta: https://tudominio.com/monchomania)
APP_URL=http://localhost/misproyectos/moncho

# --- Base de datos MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=monchomania
DB_USER=root
DB_PASS=

# --- Zona horaria ---
APP_TIMEZONE=America/Bogota
